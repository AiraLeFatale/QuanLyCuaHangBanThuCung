{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chạy chương trình (run.bat)",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "run.bat"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Kiểm tra nhanh (run.bat --check)",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "run.bat", "--check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
